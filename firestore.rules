rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Invites - authenticated users can read/write/delete
    match /invites/{inviteId} {
      allow read, write: if request.auth != null;
    }

    // Spaces
    match /spaces/{spaceId} {
      // Helper: caller is a member of this space
      function isMember() {
        return request.auth != null &&
          request.auth.uid in resource.data.memberIds;
      }

      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null && (
        // Existing member updating the space
        (request.auth.uid in resource.data.memberIds && (
          // Non-pulseConfig changes (name, updatedAt, etc.)
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pulseConfig']) ||
          // PulseConfig change — user can only modify their own picks
          (request.resource.data.pulseConfig.userPicks
            .diff(resource.data.get('pulseConfig', {'userPicks': {}}).get('userPicks', {}))
            .affectedKeys().hasOnly([request.auth.uid]))
        )) ||
        // New member joining (partner join flow)
        (request.auth.uid in request.resource.data.memberIds &&
         request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1)
      );

      // Moments subcollection - members can read/write
      match /moments/{momentId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds;

        // Editing presence subcollection - members can read/write
        match /editing/{editorId} {
          allow read, write: if request.auth != null &&
            request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds;
        }
      }

      // Check-ins subcollection - members can read; create requires schema + own userId
      match /checkins/{checkinId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds;

        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds &&
          request.resource.data.keys().hasAll(['userId', 'timestamp', 'scores']) &&
          request.resource.data.userId == request.auth.uid;

        allow update, delete: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds;
      }

      // Activities subcollection - members can read/write
      match /activities/{activityId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds;
      }
    }

    // Users - read for space members, write only for self
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.spaceId != null &&
         request.auth.uid in get(/databases/$(database)/documents/spaces/$(resource.data.spaceId)).data.memberIds)
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
